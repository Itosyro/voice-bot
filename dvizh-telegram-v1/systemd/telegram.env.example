# Never commit the real token.
TELEGRAM_BOT_TOKEN=123456:replace-me
DVIZH_TELEGRAM_PAIR_CODE=replace-with-random-one-time-code
DVIZH_TELEGRAM_DB=/var/lib/dvizh/telegram.db
DVIZH_TIMEZONE=Europe/Moscow
DVIZH_QUIET_START=23:00
DVIZH_QUIET_END=09:00
DVIZH_FOLLOWUP_MINUTES=20
DVIZH_CHECKIN_FRESH_MINUTES=240
DVIZH_SCHEDULER_TICK_SECONDS=30
DVIZH_ALLOW_MULTI_USER=false
