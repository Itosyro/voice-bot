[Unit]
Description=DVIZH authenticated AI proposal approval bridge
After=network-online.target dvizh.service dvizh-bridge.service dvizh-web-week.service
Wants=network-online.target

[Service]
Type=simple
User=dvizh
Group=dvizh
WorkingDirectory=/opt/dvizh-ai-approval
ExecStart=/usr/bin/python3 /opt/dvizh-ai-approval/proposal_bridge.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dvizh
ReadOnlyPaths=/opt/dvizh-ai-approval
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
