# ============================================================================
# Telegram
# ============================================================================
TELEGRAM_BOT_TOKEN=                    # от @BotFather

# Список разрешённых user_id через запятую. Пусто = открыто для всех.
ALLOWED_USER_IDS=

# user_id админа (один или через запятую). Имеет доступ к /sync_skills, /stats.
ADMIN_USER_IDS=

# ============================================================================
# Webhook (опционально; для self-hosted НЕ нужен — оставь пустым)
# Если WEBHOOK_URL не задан — бот работает через long-polling (по умолчанию).
# Если задан — бот регистрирует вебхук и поднимает aiohttp-сервер.
# ============================================================================
WEBHOOK_URL=
WEBHOOK_SECRET=

# ============================================================================
# Groq API ключи — ОТДЕЛЬНЫЙ КЛЮЧ НА КАЖДЫЙ РЕЖИМ
# Регистрация (бесплатно): https://console.groq.com
# ============================================================================
GROQ_API_KEY_POLISH=
GROQ_API_KEY_PROMPT=
GROQ_API_KEY_HUMANIZER=
GROQ_API_KEY_TRANSLATOR=
GROQ_API_KEY_SUMMARY=

# Fallback ключ — используется если ключ для конкретного режима не задан.
# Опционально, но рекомендуется.
GROQ_API_KEY_FALLBACK=

# ============================================================================
# Запасные LLM-провайдеры (опционально; включаются, если задан ключ)
# ============================================================================
# Cerebras (cloud.cerebras.ai): 1 млн токенов/день бесплатно, тот же gpt-oss-120b
CEREBRAS_API_KEY=
# OpenRouter (openrouter.ai): gpt-oss-120b:free с контекстом 131K — обрабатывает
# ДЛИННЫЕ транскрипты, которые не влезают в лимиты Groq free (8K TPM).
# Совет: разово купить $10 кредитов -> 1000 бесплатных запросов/день навсегда.
OPENROUTER_API_KEY=

# Стриминг-превью генерации (sendMessageDraft, Bot API 9.5+). Выключен по
# умолчанию — включать только после проверки вживую.
ENABLE_DRAFT_STREAMING=false

# ============================================================================
# Модели
# ============================================================================
# ВНИМАНИЕ: llama-3.3-70b-versatile и llama-3.1-8b-instant деприкейтнуты Groq
# (объявлено 17.06.2026, отключение 16.08.2026) — в фолбэках их быть НЕ должно.
# Все дефолты живут в src/config.py; здесь только если хочешь переопределить.
LLM_MODEL_DEFAULT=openai/gpt-oss-120b
# Запасные модели при отключении основной (через запятую)
LLM_MODEL_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-20b
# Строгий режим для Coder Strict.
# Бесплатный вариант (рекомендуем): openai/gpt-oss-120b (доступна на Free тире Groq)
# Платный (ещё лучше): moonshotai/kimi-k2-instruct (только на Developer plan)
LLM_MODEL_STRICT=openai/gpt-oss-120b
# large-v3 (НЕ turbo!) — осознанное решение: качество распознавания > скорость
WHISPER_MODEL=whisper-large-v3

# ============================================================================
# PostgreSQL
# ============================================================================
# Внутри docker-compose: postgres://postgres:postgres@db:5432/voicebot
# Локально dev: postgres://postgres:postgres@localhost:5432/voicebot
#
# Supabase (бесплатная постоянная БД): в дашборде Supabase нажми "Connect",
# выбери "Session pooler" и скопируй строку. Замени префикс postgresql:// на
# postgresql+asyncpg:// — должно получиться примерно так:
#   postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Self-hosted (вариант Б): НИЧЕГО ЗАДАВАТЬ НЕ НАДО — по умолчанию локальный
# файл SQLite (data/voicebot.db), docker-compose.server.yml подставит путь
# внутри тома. Строка ниже нужна только для managed Postgres.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/voicebot

# ============================================================================
# Лимиты и поведение
# ============================================================================
MAX_VOICE_DURATION_SEC=3600        # 1 час (длинные режутся на чанки)
MAX_VOICE_FILE_MB=20               # макс. размер аудиофайла (лимит Telegram — 20 МБ)
MAX_TEXT_LENGTH=10000
RATE_LIMIT_PER_USER_PER_MIN=20

# Кеш транскрипций — пропускать Whisper при повторной отправке того же файла
ENABLE_TRANSCRIPTION_CACHE=true

# Retention / cleanup (фоновая задача удаляет старые строки из БД)
TRANSCRIPTION_CACHE_TTL_DAYS=7      # удалять кэш транскриптов старше N дней (0 — выкл.)
REQUEST_HISTORY_TTL_DAYS=30         # удалять историю запросов старше N дней (0 — выкл.)
CLEANUP_INTERVAL_HOURS=24           # как часто запускать cleanup
CLEANUP_INITIAL_DELAY_SEC=300       # пауза перед первым запуском после старта

# ============================================================================
# Skills (нужны только режиму «Промпт»)
# ============================================================================
# Синк из GitHub идёт на каждом старте контейнера (scripts/entrypoint.sh).
# 1 — пропустить синк (быстрый старт / нет сети). Вручную: /sync_skills.
SKIP_SKILLS_SYNC=0

# ============================================================================
# Логи
# ============================================================================
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | text

# ============================================================================
# Прочее
# ============================================================================
TZ=UTC
