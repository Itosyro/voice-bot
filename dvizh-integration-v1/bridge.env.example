DVIZH_TELEGRAM_DB=/var/lib/dvizh/telegram.db
DVIZH_WEB_DB=/var/lib/dvizh/dvizh.db
DVIZH_WEB_API=http://127.0.0.1:8000
DVIZH_BRIDGE_INTERVAL_SECONDS=20
DVIZH_BRIDGE_LOOKBACK_DAYS=30
DVIZH_BRIDGE_STATUS=/var/lib/dvizh/bridge-status.json
DVIZH_BRIDGE_SYNC_SIGNAL=/var/lib/dvizh/bridge-sync-now
DVIZH_BRIDGE_HTTP_TIMEOUT=8
# Usually auto-discovered because this instance has one web user.
DVIZH_WEB_USER_ID=
DVIZH_WEB_USER_EMAIL=
