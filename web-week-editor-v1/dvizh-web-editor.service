[Unit]
Description=DVIZH web schedule editor bridge
After=network-online.target dvizh.service dvizh-auth.service dvizh-telegram.service dvizh-web-week.service
Wants=network-online.target
Requires=dvizh.service dvizh-telegram.service

[Service]
Type=simple
User=dvizh
Group=dvizh
ExecStart=/usr/bin/python3 /opt/dvizh-web-editor/web_schedule_editor_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/dvizh /opt/dvizh /opt/dvizh-web-week
ReadWritePaths=/var/lib/dvizh
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=96M

[Install]
WantedBy=multi-user.target
